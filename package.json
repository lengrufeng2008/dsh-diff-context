{
  "name": "dsh-diff-context",
  "version": "0.1.0",
  "description": "Read-only compact git diff context for DeepSeek Harness: files, additions/removals, hunks. No model, no network.",
  "type": "module",
  "bin": { "dsh-diff-context": "bin/dsh-diff-context.mjs" },
  "exports": { ".": "./plugin/index.js", "./diff": "./src/diff.mjs", "./plugin": "./plugin/index.js", "./icon": "./icon.svg" },
  "files": ["bin", "src", "plugin", "skills", "icon.svg", "README.md", "NOTICE.md", "LICENSE"],
  "dsh": { "bundle": { "patch": "./plugin/cordis.patch.yml" } },
  "engines": { "node": ">=20" },
  "keywords": ["dsh", "deepseek-harness", "git", "diff", "review", "context"],
  "license": "MIT",
  "scripts": { "test": "node --test test/*.test.mjs" },
  "repository": { "type": "git", "url": "https://github.com/lengrufeng2008/dsh-diff-context" }
}
